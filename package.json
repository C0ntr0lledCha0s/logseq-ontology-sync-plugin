{
  "name": "logseq-ontology-sync-plugin",
  "version": "0.3.0",
  "description": "Logseq DB schema builder: compose a Schema.org schema from roles such as CRM or Project Management, trim it, and export a graph-ontology EDN for import",
  "repo": "C0ntr0lledCha0s/logseq-ontology-sync-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C0ntr0lledCha0s/logseq-ontology-sync-plugin.git"
  },
  "homepage": "https://github.com/C0ntr0lledCha0s/logseq-ontology-sync-plugin#readme",
  "keywords": [
    "logseq",
    "logseq-plugin",
    "ontology",
    "schema.org",
    "db-graph",
    "schema-builder"
  ],
  "author": "C0ntr0lledCha0s",
  "license": "MIT",
  "type": "module",
  "main": "index.html",
  "logseq": {
    "id": "logseq-ontology-sync",
    "title": "Ontology Schema Builder",
    "icon": "./icon.svg"
  },
  "scripts": {
    "dev": "bun run vite",
    "build": "bun run typecheck && bun run vite build && bun run build:package",
    "build:package": "bun scripts/package.ts",
    "preview": "bun run vite preview",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bun run eslint src --ext .ts,.tsx",
    "lint:fix": "bun run eslint src --ext .ts,.tsx --fix",
    "format": "bun run prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "bun run prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "bun run tsc --noEmit",
    "deploy": "bun run build && mkdir -p /mnt/c/logseq-plugins/logseq-ontology-sync && cp -r dist/* /mnt/c/logseq-plugins/logseq-ontology-sync/"
  },
  "trustedDependencies": [
    "@logseq/libs"
  ],
  "dependencies": {
    "@logseq/libs": "0.3.4",
    "edn-data": "^1.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-logseq": "^1.1.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
